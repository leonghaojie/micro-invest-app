# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format)
# Port 5433 matches docker-compose.yml, which publishes the container on
# 5433 (not the default 5432) to avoid clashing with a native Postgres
# service that may already be bound to 5432 on your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/micro_invest?schema=public"

# Secret used to sign JWTs issued at /auth/login and /auth/register.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"

# JWT expiry (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="7d"

# Port the Express server listens on
PORT=4000

# bcrypt salt rounds (NFR-06)
BCRYPT_SALT_ROUNDS=10

# Peer-grouping widening threshold (DECISIONS.md #2 rewrite)
MIN_GROUP_SIZE=10

# No API key needed for fund data ingestion — prisma/ingest-funds-yfinance.py
# uses yfinance (unofficial Yahoo Finance wrapper), which needs no token and,
# confirmed live in this project (DECISIONS.md #1 third amendment), is the
# first source that actually covers the SGX-listed funds (A35/CFA/ES3/G3B)
# with real prices and dividends — unlike EODHD and Alpha Vantage, both
# tried first and confirmed to have zero SGX coverage on their free tiers.

# Password-reset email (DECISIONS.md #10). Gmail SMTP: turn on 2-Step
# Verification for the Google account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (NOT your
# normal Gmail password). Leave SMTP_USER/SMTP_PASS unset in development and
# the reset code is printed in the server console instead of emailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="Micro-Invest <yourname@gmail.com>"

# Automatic monthly fund-data refresh (DECISIONS.md #15). On by default: the server sleeps
# until the start of each month, then fetches the month that just ended with the Python
# yfinance script (needs: pip install yfinance), plus one catch-up check when it starts.
# It does not poll. Run it by hand with `npm run update-fund-data`.
# FUND_DATA_AUTO_UPDATE=true
# PYTHON_BIN=python        # "python3" on macOS/Linux
