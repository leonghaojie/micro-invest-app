# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/micro_invest?schema=public"

# Secret used to sign JWTs issued at /auth/login and /auth/register.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"

# JWT expiry (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="7d"

# Port the Express server listens on
PORT=4000

# bcrypt salt rounds (NFR-06)
BCRYPT_SALT_ROUNDS=10

# Peer-grouping fallback threshold (SRS §2.5, locked Phase 1)
MIN_GROUP_SIZE=10
