// Prisma schema — Design Model v1.0 §4 (Database Schema), amended per
// DECISIONS.md #1 (third amendment, real-calendar monthly backtest) and #2
// (income-range peer grouping), 25 Aug 2026.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum GoalType {
  LEARN
  HABIT
  GROWTH
}

// ── Tables ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // bcrypt salted hash (NFR-06) — never stores plaintext.
  passwordHash String
  // SRS §2.6 / v1.2: marks users created by prisma/seed.ts to fill peer
  // groups up to MIN_GROUP_SIZE. Synthetic users participate in peer-group
  // counts and percentile computation but cannot authenticate and are
  // excluded from every endpoint/view that lists individual real users.
  isSynthetic  Boolean  @default(false)
  createdAt    DateTime @default(now())
  // DECISIONS.md #8 (friends comparison): the only identity a friend ever
  // sees — never the email or id. Must be set before sending/accepting a
  // friend request.
  displayName  String?
  // Short random code another user can enter to send this user a friend
  // request. Generated lazily on first use (friends.service.ts) so existing
  // users need no backfill; there is deliberately no user search/directory.
  inviteCode   String?  @unique

  profile       UserProfile?
  plan          Plan?
  portfolios    Portfolio[]
  sharing       FriendSharing?
  passwordReset PasswordResetCode?

  sentRequests     Friendship[] @relation("FriendshipRequester")
  receivedRequests Friendship[] @relation("FriendshipAddressee")

  @@map("users")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// DECISIONS.md #8: a mutual, consent-based friend link. Declining and
// unfriending both delete the row. Postgres can't cheaply enforce
// symmetric uniqueness (A->B and B->A), so friends.service.ts rejects a
// request when a row already exists in either direction.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

// Per-metric opt-in: what accepted friends may see about this user. All
// off by default (privacy by default). The user always sees their own
// numbers regardless of these toggles.
model FriendSharing {
  id                    String  @id @default(uuid())
  userId                String  @unique
  shareValue            Boolean @default(false)
  shareReturn           Boolean @default(false)
  shareContributionRate Boolean @default(false)
  shareSavingsRate      Boolean @default(false)
  shareEmergencyBuffer  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("friend_sharing")
}

// DECISIONS.md #1 third amendment / #2 rewrite (25 Aug 2026): riskLevel and
// goalType stay (unused for peer grouping now — same "display tag, not
// authoritative" status Portfolio.riskLevel already had) but budgetBand is
// gone: its only source, an ad-hoc "monthly budget" figure, has no home
// any more now that contribution amount lives on Plan (capped by income,
// not by a separate "budget" concept). monthlyIncome/monthlyExpense/age
// are the new fields — monthlyIncome drives peer grouping (±10% widening
// range, peerGrouping.service.ts), monthlyIncome - monthlyExpense drives
// the Savings Rate metric, both profile-level and requiring no Plan.
model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  riskLevel      RiskLevel
  goalType       GoalType
  monthlyIncome  Decimal   @db.Decimal(10, 2)
  monthlyExpense Decimal   @db.Decimal(10, 2)
  age            Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// DECISIONS.md #1 second amendment (multi-fund portfolios): a Fund is a
// single real, tradable instrument (ETF/fund) with its own historical
// return series — the unit that FundMonthlyReturn and PortfolioAllocation
// both key off.
model Fund {
  id         String @id @default(uuid())
  ticker     String
  name       String
  // Free-text classification (e.g. "BOND", "EQUITY", "REIT") — informs
  // preset composition and the mobile fund browser's grouping, not an
  // enum since the real fund universe isn't fixed to three risk tiers
  // any more.
  assetClass String
  // Exchange code, e.g. "US" or "SGX".
  exchange   String
  currency   String
  // "YFINANCE" — see ingest-funds-yfinance.ts. ("EODHD"/"WEB_SEARCH" were
  // the prior pipelines, both superseded — DECISIONS.md #1 third
  // amendment: yfinance is the first source that actually covers the SGX
  // funds with real prices+dividends, which neither of those could.)
  dataSource String

  monthlyReturns FundMonthlyReturn[]
  allocations    PortfolioAllocation[]

  @@unique([ticker, exchange])
  @@map("funds")
}

// DECISIONS.md #1 third amendment (25 Aug 2026): replaces HistoricalReturn.
// One row per real calendar month actually traded by the real fund, so the
// engine (plan.service.ts) can replay a user-chosen start month through to
// "now" using the fund's own real monthly return — no annual-rate
// derivation, no wrap-around. Sourced via yfinance (ingest-funds-yfinance.ts),
// which — confirmed live, this session — covers the SGX funds (A35/CFA/
// ES3/G3B) that neither EODHD nor Alpha Vantage could.
model FundMonthlyReturn {
  id             String   @id @default(uuid())
  fundId         String
  monthDate      DateTime // first-of-month, e.g. 2026-01-01
  startPrice     Decimal  @db.Decimal(12, 4)
  endPrice       Decimal  @db.Decimal(12, 4)
  dividendAmount Decimal  @default(0) @db.Decimal(10, 4)
  // (endPrice + dividendAmount - startPrice) / startPrice
  returnPct      Decimal  @db.Decimal(8, 6)

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, monthDate])
  @@map("fund_monthly_returns")
}

// DECISIONS.md #1 second amendment: a Portfolio is a named allocation
// across one or more Funds — either a system preset (userId null, isPreset
// true) or a user's own custom multi-fund composition. riskLevel is a
// display/classification tag only, not authoritative for anything.
model Portfolio {
  id        String     @id @default(uuid())
  userId    String?
  name      String
  riskLevel RiskLevel?
  isPreset  Boolean    @default(false)
  createdAt DateTime   @default(now())

  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations PortfolioAllocation[]
  plans       Plan[]

  @@map("portfolios")
}

// Weights are validated in portfolio.service.ts to sum to 100.00 per
// portfolio — not a DB constraint (Postgres can't cheaply enforce a
// sum-across-rows check without a trigger, out of scope for the MVP).
model PortfolioAllocation {
  id          String  @id @default(uuid())
  portfolioId String
  fundId      String
  weightPct   Decimal @db.Decimal(5, 2)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  fund      Fund      @relation(fields: [fundId], references: [id])

  @@unique([portfolioId, fundId])
  @@map("portfolio_allocations")
}

// DECISIONS.md #1 third amendment: replaces Simulation. A user has at most
// one active Plan (userId is @unique, not just indexed) — starting a new
// plan.service.ts run deletes the old Plan (cascading its PlanMonths) and
// creates a fresh one, per the user's explicit "one active plan at a time"
// call. startMonth is user-chosen (e.g. 2026-01-01); the plan always runs
// through to the real current month — there is no storable "end month" or
// duration, months are (re)computed on every read (plan.service.ts).
model Plan {
  id                 String   @id @default(uuid())
  userId             String   @unique
  portfolioId        String
  contributionAmount Decimal  @db.Decimal(10, 2)
  startMonth         DateTime // first-of-month
  createdAt          DateTime @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio   @relation(fields: [portfolioId], references: [id])
  months    PlanMonth[]

  @@map("plans")
}

// One row per real calendar month from Plan.startMonth to "now" —
// recomputed and upserted fresh on every read (plan.service.ts), not
// incrementally maintained, so new real months/newly-ingested fund data
// are always reflected without a cron job.
model PlanMonth {
  id                 String   @id @default(uuid())
  planId             String
  monthDate          DateTime
  // Rp,t — the weight-blended fund return for this month.
  portfolioReturnPct Decimal  @db.Decimal(8, 6)
  contribution       Decimal  @db.Decimal(10, 2)
  // Vt
  endingBalance      Decimal  @db.Decimal(14, 2)
  // Cumulative contributions through this month.
  totalInvested      Decimal  @db.Decimal(12, 2)
  // Cumulative (monthlyIncome - monthlyExpense - contribution) through this
  // month — feeds the Emergency Buffer metric (walletBalance / monthlyExpense).
  walletBalance      Decimal  @db.Decimal(12, 2)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, monthDate])
  @@map("plan_months")
}

// DECISIONS.md #10 (password reset): at most one outstanding reset code per
// user — requesting a new code replaces the old one. Only an HMAC of the
// 6-digit code is stored (never the code itself), it expires after 15
// minutes, and it is deleted after 5 wrong guesses or on successful use.
model PasswordResetCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}
