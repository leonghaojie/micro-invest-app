// Prisma schema — Design Model v1.0 §4 (Database Schema).
// Derived directly from the SRS Data Dictionary (§4) and the Phase 1 locked
// decisions (`FYP Roadmap.docx` Phase 1 / DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── §4.1 Enums ──────────────────────────────────────────────────────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum GoalType {
  LEARN
  HABIT
  GROWTH
}

enum BudgetBand {
  B1
  B2
  B3
  B4
}

enum ContributionFrequency {
  WEEKLY
  MONTHLY
}

// DECISIONS.md #6: how a period's contributionAmount is arrived at.
// SCHEDULED — the user enters a fixed amount directly (the original
// model). ROUND_UP — derived from spare-change parameters (average
// transactions/week x average round-up per transaction), computed once
// and applied uniformly to every period, same as SCHEDULED — still a
// single deterministic per-period figure, no simulated transaction
// stream, so NFR-04 holds the same way it always has.
enum ContributionMechanism {
  SCHEDULED
  ROUND_UP
}

enum PeerGroupTier {
  FULL
  RISK_BUDGET
  RISK_ONLY
}

// ── §4.2 Tables ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // bcrypt salted hash (NFR-06) — never stores plaintext.
  passwordHash String
  // SRS §2.6 / v1.2: marks users created by prisma/seed.ts to fill peer
  // groups up to MIN_GROUP_SIZE. Synthetic users participate in peer-group
  // counts and percentile computation but cannot authenticate and are
  // excluded from every endpoint/view that lists individual real users.
  isSynthetic  Boolean  @default(false)
  createdAt    DateTime @default(now())

  profile     UserProfile?
  simulations Simulation[]
  portfolios  Portfolio[]

  @@map("users")
}

model UserProfile {
  id         String     @id @default(uuid())
  userId     String     @unique
  riskLevel  RiskLevel
  goalType   GoalType
  // Derived server-side from raw monthly budget input (UC-02 step 4).
  budgetBand BudgetBand

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// DECISIONS.md #1 second amendment (multi-fund portfolios): a Fund is a
// single real, tradable instrument (ETF/fund) with its own historical
// return series — the unit that HistoricalReturn and PortfolioAllocation
// both key off. Replaces PortfolioTemplate's role as the thing returns
// attach to; PortfolioTemplate itself is gone (see Portfolio below).
model Fund {
  id         String @id @default(uuid())
  ticker     String
  name       String
  // Free-text classification (e.g. "BOND", "EQUITY", "REIT") — informs
  // preset composition and the mobile fund browser's grouping, not an
  // enum since the real fund universe isn't fixed to three risk tiers
  // any more.
  assetClass String
  // Exchange code — EODHD's own code (e.g. "US", "LSE") for
  // dataSource=EODHD funds, or "SGX" for web-search-sourced ones (EODHD's
  // plan used here doesn't cover Singapore — see ingest-funds.ts).
  exchange   String
  currency   String
  // "EODHD" | "WEB_SEARCH" — which pipeline populated historicalReturns,
  // kept so it's always traceable which rows are audit-grade API data
  // versus search-summarized (DECISIONS.md #1 amendment caveat).
  dataSource String

  historicalReturns HistoricalReturn[]
  allocations       PortfolioAllocation[]

  @@unique([ticker, exchange])
  @@map("funds")
}

// DECISIONS.md #1 amendment: real, dated annual returns backing the
// deterministic historical-replay engine (simulation.service.ts). One row
// per calendar year actually traded by the real fund — series length
// varies by fund (e.g. CFA only has 8 years, its real fund having
// launched March 2017), which is why this is its own table keyed by year
// rather than a fixed-length array.
model HistoricalReturn {
  id         String  @id @default(uuid())
  fundId     String
  year       Int
  // Real annual total return for that calendar year (source: EODHD API or
  // fund performance-history pages — see Fund.dataSource and
  // DECISIONS.md #1 amendments for the per-fund citation and precision
  // caveats).
  returnRate Decimal @db.Decimal(6, 4)

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, year])
  @@map("historical_returns")
}

// DECISIONS.md #1 second amendment: replaces PortfolioTemplate. A
// Portfolio is a named allocation across one or more Funds — either a
// system preset (userId null, isPreset true — e.g. what used to be the
// fixed Conservative/Balanced/Growth templates, now expressed as a
// single-fund 100%-weight allocation each) or a user's own custom
// multi-fund composition (userId set, isPreset false). riskLevel is a
// display/classification tag only — peer grouping still keys off
// UserProfile.riskLevel (DECISIONS.md #2), not which funds a user
// actually invests in, so this stays nullable and non-authoritative.
model Portfolio {
  id        String     @id @default(uuid())
  userId    String?
  name      String
  riskLevel RiskLevel?
  isPreset  Boolean    @default(false)
  createdAt DateTime   @default(now())

  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations PortfolioAllocation[]
  simulations Simulation[]

  @@map("portfolios")
}

// Weights are validated in portfolio.service.ts to sum to 100.00 per
// portfolio — not a DB constraint (Postgres can't cheaply enforce a
// sum-across-rows check without a trigger, out of scope for the MVP).
model PortfolioAllocation {
  id          String  @id @default(uuid())
  portfolioId String
  fundId      String
  weightPct   Decimal @db.Decimal(5, 2)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  fund      Fund      @relation(fields: [fundId], references: [id])

  @@unique([portfolioId, fundId])
  @@map("portfolio_allocations")
}

model Simulation {
  id          String                @id @default(uuid())
  userId      String
  portfolioId String
  frequency   ContributionFrequency
  mechanism   ContributionMechanism @default(SCHEDULED)
  // Always the actual per-period amount used, regardless of mechanism:
  // user-entered directly for SCHEDULED, derived (and stored back here)
  // for ROUND_UP — every downstream reader (dashboard.service.ts's
  // totalContributed reconstruction, simulation history) can stay
  // mechanism-agnostic and just read this one field.
  contributionAmount Decimal @db.Decimal(12, 2)
  // ROUND_UP inputs only — kept as an audit trail of what produced
  // contributionAmount above; null for SCHEDULED runs.
  avgTransactionsPerWeek Int?
  avgRoundUpAmount       Decimal? @db.Decimal(6, 2)
  durationMonths         Int
  // Populated once the run completes (FR06).
  finalValue             Decimal? @db.Decimal(14, 2)
  createdAt              DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio     Portfolio      @relation(fields: [portfolioId], references: [id])
  contributions Contribution[]

  @@map("simulations")
}

model Contribution {
  id             String  @id @default(uuid())
  simulationId   String
  // One row per period; ordered by periodIndex.
  periodIndex    Int
  amount         Decimal @db.Decimal(12, 2)
  portfolioValue Decimal @db.Decimal(14, 2)

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, periodIndex])
  @@map("contributions")
}

model PeerGroup {
  id         String        @id @default(uuid())
  riskLevel  RiskLevel
  // Nullable — null once relaxed past FULL/RISK_BUDGET (Design Model §5.1).
  budgetBand BudgetBand?
  goalType   GoalType?
  tier       PeerGroupTier

  stats PeerGroupStats?

  @@map("peer_groups")
}

model PeerGroupStats {
  id                String   @id @default(uuid())
  peerGroupId       String   @unique
  medianValue       Decimal  @db.Decimal(14, 2)
  p25               Decimal  @db.Decimal(14, 2)
  p50               Decimal  @db.Decimal(14, 2)
  p75               Decimal  @db.Decimal(14, 2)
  // Each member's own ConsistencyScore (SRS §4 formula), median-aggregated
  // — computed and persisted by peerBenchmark.service.ts (DECISIONS.md #3).
  medianConsistency Decimal? @db.Decimal(5, 2)
  memberCount       Int
  lastComputedAt    DateTime @default(now())

  peerGroup PeerGroup @relation(fields: [peerGroupId], references: [id], onDelete: Cascade)

  @@map("peer_group_stats")
}
